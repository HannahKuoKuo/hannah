# 数据库配置
DATABASE_URL=postgresql://user:password@localhost:5432/acesign_analytics
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password
DATABASE_NAME=acesign_analytics
DATABASE_HOST=localhost
DATABASE_PORT=5432

# API 服务器
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=development
NODE_LOG_LEVEL=info

# JWT 认证
JWT_SECRET=your-super-secret-key-change-this
JWT_EXPIRATION=7d

# MailerLite API
MAILERLITE_API_TOKEN=your_mailerlite_token_here
MAILERLITE_API_BASE_URL=https://connect.mailerlite.com/api

# Meta (Facebook/Instagram) API
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_BUSINESS_ACCOUNT_ID=your_business_account_id
META_PAGE_ID=your_page_id
META_PAGE_ACCESS_TOKEN=your_page_token

# Google Analytics 4
GA4_PROPERTY_ID=your_ga4_property_id
GA4_MEASUREMENT_ID=your_measurement_id
GA4_API_SECRET=your_ga4_api_secret

# LinkedIn API
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_ORGANIZATION_ID=your_organization_id

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# 邮件配置
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hannah@acesign.com.au
SMTP_PASSWORD=your_app_password
NOTIFICATION_EMAIL=hannah@acesign.com.au

# 应用配置
APP_NAME=ACE Sign Analytics
APP_URL=https://acesign.com.au
WEBSITE_URL=https://acesign.com.au

# AWS S3 (用于存储报告)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=acesign-reports

# UTM 配置
UTM_SHORT_URL_API=https://tinyurl.com/api/create.php
UTM_TRACKING_DOMAIN=https://track.acesign.com.au

# 内容排程配置
INSTAGRAM_POSTS_PER_WEEK=2
INSTAGRAM_STORIES_PER_DAYS=3
LINKEDIN_POSTS_PER_WEEK=1
NEWSLETTER_POSTS_PER_MONTH=1

# 日志配置
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# 前端配置
REACT_APP_API_URL=http://localhost:3001
REACT_APP_APP_NAME=ACE Sign Analytics

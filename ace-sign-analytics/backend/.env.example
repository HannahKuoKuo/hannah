# Server Configuration
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ace_analytics_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ace_analytics_db
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRY=7d

# MailerLite
MAILERLITE_API_TOKEN=your_mailerlite_api_token

# Meta (Facebook)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_BUSINESS_ACCOUNT_ID=your_meta_business_account_id
META_PAGE_ID=your_meta_page_id
META_ACCESS_TOKEN=your_meta_access_token

# Google Analytics 4
GA4_PROPERTY_ID=your_ga4_property_id
GA4_API_KEY=your_ga4_api_key
GA4_MEASUREMENT_ID=your_ga4_measurement_id

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password
ADMIN_EMAIL=hannah@acesign.com.au

# Logging
LOG_LEVEL=debug

# CORS
CORS_ORIGIN=http://localhost:5173

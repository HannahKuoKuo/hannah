# -----------------------------------------------------------------------------
# ACE SIGN Marketing Hub - environment variables
# Copy to .env.local (Next.js) and .env (Prisma CLI). Never commit real values.
# -----------------------------------------------------------------------------

# Database (matches docker-compose.yml - local development only)
DATABASE_URL="postgresql://acesign:acesign_local_only@localhost:5432/acesign_hub?schema=public"

# Auth.js (Phase 2). Generate with: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# AI provider: "demo" (offline templates, default) | "anthropic" (Phase 3)
AI_PROVIDER="demo"
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5-5"

# -----------------------------------------------------------------------------
# Integrations - all DISABLED by default. Set *_ENABLED="true" only after
# credentials are provisioned through the official OAuth / developer portals.
# -----------------------------------------------------------------------------
META_ENABLED="false"
META_APP_ID=""
META_APP_SECRET=""
META_AD_ACCOUNT_ID=""

LINKEDIN_ENABLED="false"
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

GA4_ENABLED="false"
GA4_PROPERTY_ID=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

EMAIL_PROVIDER_ENABLED="false"
EMAIL_PROVIDER="mailerlite"
EMAIL_PROVIDER_API_KEY=""
